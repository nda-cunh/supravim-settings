using Gtk 4.0;
using Adw 1;

template $ThemePage: Adw.PreferencesGroup {
	Adw.PreferencesGroup theme_group {
		hexpand: false;
		vexpand: false;
		halign: center;
		valign: center;
		margin-bottom: 20;
		styles ['PreferencesGroup']
		description: _("Change your theme");
		title: _("Themes");
		Box box {

		}
	}
}
