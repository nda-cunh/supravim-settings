using Gtk 4.0;
using Adw 1;


template $MainWindow: Adw.ApplicationWindow {
	default-width: -1;
	default-height: 950;
	width-request: 700;
	title: "──  SupraVim  ──";

	content: Adw.ToastOverlay toast_overlay {
	child: Box {
		orientation: vertical;

		Adw.HeaderBar { }

		Adw.ViewStack viewstack {
			hexpand:false;
			vexpand:true;
			
			// Home Page
			Adw.ViewStackPage {
				name: 'general';
				icon-name: 'go-home-symbolic';
				title: _("General");
				child: ScrolledWindow {
					Viewport {
						vexpand: false;
						hexpand: false;
						$HomePage home_page {
						}
					}
				};
			}


			// Options Page
			Adw.ViewStackPage {
				name: 'options';
				icon-name: 'emblem-system-symbolic';
				title: _("Options");
				child: ScrolledWindow {
					Viewport {
						$OptionsPage options_page { }
					}
				};
			}

			
			// Plugins Page
			Adw.ViewStackPage {
				name: 'plugins';
				title: _("Plugins");
				icon-name: 'insert-object-symbolic';
				child: $PluginsPage plugins_page { };
			}
			

			// LSP Page
			Adw.ViewStackPage {
				name: 'lsp';
				icon-name: 'utilities-terminal-symbolic';
				title: _("LSP");
				child: $LspPage lsp_page { };
			}

			// Stats & Achievements Page
			Adw.ViewStackPage {
				name: 'stats';
				icon-name: 'starred-symbolic';
				title: _("Stats");
				child: $StatsPage stats_page { };
			}

			// Snippets Page
			Adw.ViewStackPage {
				name: 'snippets';
				icon-name: 'document-edit-symbolic';
				title: _("Snippets");
				child: $SnippetsPage snippets_page { };
			}


			// Wiki Page
			Adw.ViewStackPage wiki_page{
				name: 'wiki';
				title: _("Wiki");
				icon-name: 'emblem-important-symbolic';
				child: Box wiki_box{
					hexpand:true;
					vexpand:true;

				};
			}
		}

		Adw.ViewSwitcherBar {
			stack: viewstack;
			reveal: true;
		}
	};
	};
}
